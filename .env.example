# Plantilla general. Para desarrollo usa .env.test.example.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
AUTH_TOKEN_SECRET=replace-locally
