# Configuración no secreta. En Cloudflare se administra como vars por entorno.
APP_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:4200
DATA_ADAPTER=placeholder
GRAPH_AUTH_MODE=disabled
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=

# Nunca guardar valores reales de estas variables en el repositorio:
AUTH_TOKEN_SECRET=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=
