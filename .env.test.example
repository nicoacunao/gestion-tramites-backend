# Copiar como .env.test y completar con la base Supabase de prueba.
APP_ENV=test
DATABASE_URL=postgresql://usuario:contraseña@host-de-test:5432/postgres
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
AUTH_TOKEN_SECRET=replace-with-a-test-secret
