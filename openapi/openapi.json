{
  "openapi": "3.0.3",
  "info": {
    "title": "API Gestión de Trámites",
    "version": "0.1.0",
    "description": "Contrato inicial. Solo contiene health checks por módulo."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Desarrollo local"
    },
    {
      "url": "https://replace-with-staging-domain.invalid",
      "description": "Staging"
    },
    {
      "url": "https://replace-with-production-domain.invalid",
      "description": "Producción"
    }
  ],
  "components": {
    "schemas": {
      "ModuleHealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ModuleHealthData"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "ModuleHealthData": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "example": "gestiones"
          },
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["module", "status"]
      },
      "ApiMeta": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "example": "4b118c2e-f0f6-4be9-9713-9ed923f44a68"
          }
        },
        "required": ["requestId"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "RESOURCE_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "El recurso solicitado no existe."
              },
              "details": {
                "nullable": true
              }
            },
            "required": ["code", "message"]
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["error", "meta"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "rut": {
                    "type": "string"
                  },
                  "names": {
                    "type": "string"
                  },
                  "firstSurname": {
                    "type": "string"
                  },
                  "secondSurname": {
                    "type": "string",
                    "nullable": true
                  },
                  "email": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string"
                  }
                },
                "required": ["id", "rut", "names", "firstSurname", "secondSurname", "email", "role"]
              }
            },
            "required": ["accessToken", "expiresAt", "user"]
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "rut": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "12.345.678-9"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "••••••••"
          }
        },
        "required": ["rut", "password"]
      },
      "StationListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Station"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "Station": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 150
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "commune": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "zoneManager": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "commercialManager": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "companyRut": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "legalRepresentative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "legalRepresentativeRut": {
            "type": "string",
            "nullable": true,
            "maxLength": 12
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "address",
          "commune",
          "legalName",
          "zoneManager",
          "commercialManager",
          "companyRut",
          "legalRepresentative",
          "status",
          "version"
        ]
      },
      "StationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Station"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "StationWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 150
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "commune": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "zoneManager": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "commercialManager": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "companyRut": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "legalRepresentative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "legalRepresentativeRut": {
            "type": "string",
            "nullable": true,
            "maxLength": 12
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "required": [
          "id",
          "address",
          "commune",
          "legalName",
          "zoneManager",
          "commercialManager",
          "companyRut",
          "legalRepresentative",
          "status"
        ]
      },
      "StationUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StationWrite"
          },
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              }
            },
            "required": ["version"]
          }
        ]
      },
      "CatalogListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "nullable": true
                  }
                ]
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "ManagementListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Management"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "Management": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "managementTypeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scopeCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "responsibleUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "level": {
            "type": "string",
            "enum": ["N1", "N2", "N3", "N4"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "openedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "estimatedCompletionOn": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lastReviewedOn": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "priority": {
            "type": "string",
            "enum": ["Alta", "Media", "Baja"]
          },
          "requesterName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "status": {
            "type": "string",
            "nullable": true,
            "enum": [
              "Borrador",
              "Pendiente",
              "Ingresado",
              "En tramitación",
              "Observado",
              "Reingresado",
              "Rechazado",
              "Terminado aprobado",
              "Terminado desfavorable",
              null
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "stationId",
          "managementTypeId",
          "scopeCode",
          "responsibleUserId",
          "level",
          "sequence",
          "openedOn",
          "estimatedCompletionOn",
          "lastReviewedOn",
          "priority",
          "requesterName",
          "status",
          "version"
        ]
      },
      "ManagementResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Management"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "ManagementWrite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "managementTypeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scopeCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "responsibleUserId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "level": {
            "type": "string",
            "enum": ["N1", "N2", "N3", "N4"]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "openedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "estimatedCompletionOn": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lastReviewedOn": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "priority": {
            "type": "string",
            "enum": ["Alta", "Media", "Baja"]
          },
          "requesterName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "status": {
            "type": "string",
            "nullable": true,
            "enum": [
              "Borrador",
              "Pendiente",
              "Ingresado",
              "En tramitación",
              "Observado",
              "Reingresado",
              "Rechazado",
              "Terminado aprobado",
              "Terminado desfavorable",
              null
            ]
          }
        },
        "required": [
          "id",
          "stationId",
          "managementTypeId",
          "scopeCode",
          "responsibleUserId",
          "level",
          "sequence",
          "openedOn",
          "estimatedCompletionOn",
          "lastReviewedOn",
          "priority",
          "requesterName",
          "status"
        ]
      },
      "ManagementUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ManagementWrite"
          },
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              }
            },
            "required": ["version"]
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/identidad/health": {
      "get": {
        "operationId": "identidadHealth",
        "tags": ["identidad"],
        "summary": "Health check del módulo identidad",
        "responses": {
          "200": {
            "description": "El módulo está disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleHealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/identidad/login": {
      "post": {
        "tags": ["identidad"],
        "operationId": "identidadLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogos/health": {
      "get": {
        "operationId": "catalogosHealth",
        "tags": ["catalogos"],
        "summary": "Health check del módulo catalogos",
        "responses": {
          "200": {
            "description": "El módulo está disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleHealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalogos/items": {
      "get": {
        "tags": ["catalogos"],
        "operationId": "catalogosListStations",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "eds",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "commune",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "legalName",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Estaciones.",
