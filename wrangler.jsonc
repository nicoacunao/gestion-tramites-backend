{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestion-tramites-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    "LOG_LEVEL": "debug",
    "CORS_ORIGINS": "http://localhost:4200",
    "DATA_ADAPTER": "sql",
    "GRAPH_AUTH_MODE": "disabled",
  },
  "env": {
    "test": {
      "name": "gestion-tramites-api-test",
      "vars": {
        "APP_ENV": "test",
        "LOG_LEVEL": "debug",
        "CORS_ORIGINS": "http://localhost:4200",
        "DATA_ADAPTER": "sql",
        "GRAPH_AUTH_MODE": "disabled",
      },
    },
    "staging": {
      "name": "gestion-tramites-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "https://staging.gestion-tramites.pages.dev",
        "DATA_ADAPTER": "sql",
        "GRAPH_AUTH_MODE": "disabled",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ab7bbb8b9f0d433a9436001b306ee4c3",
        },
      ],
    },
    "production": {
      "name": "gestion-tramites-api",
      "vars": {
        "APP_ENV": "production",
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "https://gestion-tramites.pages.dev",
        "DATA_ADAPTER": "sql",
        "GRAPH_AUTH_MODE": "disabled",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "56c644d0b84648e59a594946ff4c61d1",
        },
      ],
    },
  },
}
