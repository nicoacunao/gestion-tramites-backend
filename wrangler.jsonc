{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestion-tramites-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    "LOG_LEVEL": "debug",
    "CORS_ORIGINS": "http://localhost:4200",
    "DATA_ADAPTER": "placeholder",
    "GRAPH_AUTH_MODE": "disabled",
  },
  "env": {
    "staging": {
      "name": "gestion-tramites-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "https://replace-with-staging-domain.invalid",
        "DATA_ADAPTER": "placeholder",
        "GRAPH_AUTH_MODE": "disabled",
      },
    },
    "production": {
      "name": "gestion-tramites-api",
      "vars": {
        "APP_ENV": "production",
        "LOG_LEVEL": "info",
        "CORS_ORIGINS": "https://replace-with-production-domain.invalid",
        "DATA_ADAPTER": "placeholder",
        "GRAPH_AUTH_MODE": "disabled",
      },
    },
  },
}
